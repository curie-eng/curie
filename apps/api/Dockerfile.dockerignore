# Per-Dockerfile ignore (BuildKit honors <dockerfile>.dockerignore over the
# context-root .dockerignore). These app images build from the REPO ROOT to
# reach the uv workspace, so this trims the root context to what the Python
# build needs -- the uv.lock, member pyproject.tomls, and Python sources stay;
# the heavy non-Python trees are dropped.
**/.venv
**/__pycache__
**/*.pyc
**/.mypy_cache
**/.pytest_cache
**/.ruff_cache
**/node_modules
apps/ui/dist
apps/ui/test-results
apps/ui/playwright-report
cli/target
docs
prototypes
.github
charts
*.md
**/*.md
**/.env
**/.env.*
!**/.env.example
!**/.env.sample
!**/.env.template
**/.ssh
**/.aws
**/*.key
**/*.pem
**/*.p12
**/*.pfx
**/id_rsa
**/id_dsa
**/id_ecdsa
**/id_ed25519
**/.git
**/.curie
**/.projects
**/.worktrees
**/.claude
**/.claude.json*
**/.agents
**/.codex
**/.t3
**/.cache
**/.config
**/.local
**/.npm
**/.bun
**/.netrc
**/.npmrc
**/.yarnrc
**/.yarnrc.yml
**/.mcp.json
!packages/plugin-format/tests/fixtures/valid_bundle/.mcp.json
!packages/plugin-format/tests/fixtures/bad_mcp/.mcp.json
