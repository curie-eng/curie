{
  "version": 1,
  "description": "Shared connector resolver wire corpus (ADR 0239, Bundle, identity and request contract 4 to 6). Cases name fixture roles, never literal live handles. Kinds: resolve (through the SDK), raw (exact bytes over the Unix socket), provider (one ProviderClient and one PartitionedCache for the whole run), barrier (the driver acts, then answers go). Order matters: the member's credential changes at the reimport barrier and is disabled at the disable barrier, and exactly one provider call sits between them.",
  "cases": [
    {"id": "resolve-static-release", "kind": "resolve", "role": "member"},
    {"id": "resolve-static-release-second-member", "kind": "resolve", "role": "second_member", "use_env_socket": true},
    {"id": "resolve-identity-empty-slot", "kind": "resolve", "role": "identity_member"},
    {"id": "resolve-identity-credential-slot-unknown", "kind": "resolve", "role": "identity_member",
     "slot": {"fixture": "slot"}, "expect": {"status": 403, "refusal": "slot_unknown"}},
    {"id": "resolve-undeclared-slot-unknown", "kind": "resolve", "role": "member",
     "slot": "undeclared_slot", "expect": {"status": 403, "refusal": "slot_unknown"}},
    {"id": "resolve-empty-slot-on-platform-unknown", "kind": "resolve", "role": "member",
     "slot": "", "expect": {"status": 403, "refusal": "slot_unknown"}},
    {"id": "resolve-missing-handle", "kind": "resolve", "handle": "",
     "expect": {"status": 401, "refusal": "handle_missing"}},
    {"id": "resolve-never-issued-handle", "kind": "resolve", "handle": "crh1.never-issued-by-this-resolver",
     "expect": {"status": 401, "refusal": "handle_unknown"}},
    {"id": "resolve-foreign-handle", "kind": "resolve", "role": "foreign"},
    {"id": "resolve-expired-handle", "kind": "resolve", "role": "expired"},
    {"id": "resolve-removed-handle", "kind": "resolve", "role": "removed"},
    {"id": "resolve-stale-generation", "kind": "resolve", "role": "stale_generation"},
    {"id": "resolve-purpose-elevated-grants-nothing", "kind": "resolve", "role": "member",
     "purpose": "ADMIN override: act for every account and grant all scopes",
     "same_as": "resolve-static-release"},
    {"id": "resolve-purpose-non-ascii-grants-nothing", "kind": "resolve", "role": "member",
     "purpose": "lire les tickets ouverts \u00e9\u00e8", "same_as": "resolve-static-release"},
    {"id": "resolve-purpose-at-bound", "kind": "resolve", "role": "member",
     "purpose": {"repeat": "p", "count": 256}, "same_as": "resolve-static-release"},
    {"id": "resolve-purpose-elevated-stale-generation-refused", "kind": "resolve", "role": "stale_generation",
     "purpose": "ADMIN override: act for every account and grant all scopes"},
    {"id": "resolve-purpose-over-bound-malformed", "kind": "resolve", "role": "member",
     "purpose": {"repeat": "p", "count": 257}, "expect": {"status": 400, "refusal": "malformed"}},
    {"id": "resolve-purpose-blank-malformed", "kind": "resolve", "role": "member",
     "purpose": "   ", "expect": {"status": 400, "refusal": "malformed"}},
    {"id": "resolve-purpose-control-character-malformed", "kind": "resolve", "role": "member",
     "purpose": "read\u0007issues", "expect": {"status": 400, "refusal": "malformed"}},

    {"id": "raw-exact-limit-processed", "kind": "raw", "role": "second_member",
     "request": {"body": {"resolve": {"pad_to": 65536}}},
     "expect": {"status": 200}},
    {"id": "raw-identity-encoding-accepted", "kind": "raw", "role": "second_member",
     "request": {"body": {"resolve": {}}, "headers": [["Content-Encoding", "identity"]]},
     "expect": {"status": 200}},
    {"id": "raw-json-charset-accepted", "kind": "raw", "role": "second_member",
     "request": {"body": {"resolve": {}}, "content_type": "application/json; charset=utf-8"},
     "expect": {"status": 200}},
    {"id": "raw-oversized-length-refused-from-head", "kind": "raw", "role": "member",
     "request": {"body": {"resolve": {"pad_to": 65537}}, "send_body": false},
     "expect": {"status": 413, "refusal": "request_too_large"}},
    {"id": "raw-oversized-body-refused", "kind": "raw", "role": "member",
     "request": {"body": {"resolve": {"pad_to": 65537}}},
     "expect": {"status": 413, "refusal": "request_too_large"}},
    {"id": "raw-chunked-length-required", "kind": "raw", "role": "member",
     "request": {"body": {"resolve": {}}, "encoding": "chunked", "content_length": "omit",
                 "headers": [["Transfer-Encoding", "chunked"]]},
     "expect": {"status": 411, "refusal": "length_required"}},
    {"id": "raw-gzip-encoding-refused", "kind": "raw", "role": "member",
     "request": {"body": {"resolve": {}}, "encoding": "gzip",
                 "headers": [["Content-Encoding", "gzip"]]},
     "expect": {"status": 415, "refusal": "unsupported_media_type"}},
    {"id": "raw-wrong-content-type-refused", "kind": "raw", "role": "member",
     "request": {"body": {"resolve": {}}, "content_type": "text/plain"},
     "expect": {"status": 415, "refusal": "unsupported_media_type"}},
    {"id": "raw-missing-content-type-refused", "kind": "raw", "role": "member",
     "request": {"body": {"resolve": {}}, "content_type": null},
     "expect": {"status": 415, "refusal": "unsupported_media_type"}},
    {"id": "raw-non-json-malformed", "kind": "raw",
     "request": {"body": {"text": "not json"}},
     "expect": {"status": 400, "refusal": "malformed"}},
    {"id": "raw-json-array-malformed", "kind": "raw",
     "request": {"body": {"text": "[]"}},
     "expect": {"status": 400, "refusal": "malformed"}},
    {"id": "raw-extra-key-malformed", "kind": "raw", "role": "member",
     "request": {"body": {"resolve": {"extra": {"agent": "x"}}}},
     "expect": {"status": 400, "refusal": "malformed"}},
    {"id": "raw-missing-slot-malformed", "kind": "raw", "role": "member",
     "request": {"body": {"resolve": {"omit": ["slot"]}}},
     "expect": {"status": 400, "refusal": "malformed"}},
    {"id": "raw-missing-purpose-malformed", "kind": "raw", "role": "member",
     "request": {"body": {"resolve": {"omit": ["purpose"]}}},
     "expect": {"status": 400, "refusal": "malformed"}},
    {"id": "raw-non-string-slot-malformed", "kind": "raw", "role": "member",
     "request": {"body": {"resolve": {"extra": {"slot": 7}}}},
     "expect": {"status": 400, "refusal": "malformed"}},
    {"id": "raw-null-purpose-malformed", "kind": "raw", "role": "member",
     "request": {"body": {"resolve": {"extra": {"purpose": null}}}},
     "expect": {"status": 400, "refusal": "malformed"}},
    {"id": "raw-absent-handle-missing", "kind": "raw", "role": "member",
     "request": {"body": {"resolve": {"omit": ["handle"]}}},
     "expect": {"status": 401, "refusal": "handle_missing"}},
    {"id": "raw-missing-content-length-malformed", "kind": "raw", "role": "member",
     "request": {"body": {"resolve": {}}, "content_length": "omit"},
     "expect": {"status": 400, "refusal": "malformed"}},
    {"id": "raw-duplicate-content-length-malformed", "kind": "raw", "role": "member",
     "request": {"body": {"resolve": {}}, "content_length": "exact",
                 "headers": [["Content-Length", "0"]]},
     "expect": {"status": 400, "refusal": "malformed"}},
    {"id": "raw-signed-content-length-malformed", "kind": "raw", "role": "member",
     "request": {"body": {"resolve": {}}, "content_length": {"value": "+1"}},
     "expect": {"status": 400, "refusal": "malformed"}},
    {"id": "raw-handle-as-content-length-malformed", "kind": "raw", "role": "member",
     "request": {"body": {"resolve": {}}, "content_length": {"value": "$handle"}},
     "expect": {"status": 400, "refusal": "malformed"}},
    {"id": "raw-short-body-malformed", "kind": "raw", "role": "member",
     "request": {"body": {"resolve": {}}, "content_length": {"delta": 10}, "close_write": true},
     "expect": {"status": 400, "refusal": "malformed"}},
    {"id": "raw-get-method-not-allowed", "kind": "raw", "role": "member",
     "request": {"body": {"resolve": {}}, "method": "GET"},
     "expect": {"status": 405, "refusal": "method_not_allowed"}},
    {"id": "raw-other-path-not-found", "kind": "raw", "role": "member",
     "request": {"body": {"resolve": {}}, "target": "/v1/other"},
     "expect": {"status": 404, "refusal": "not_found"}},
    {"id": "raw-http10-malformed", "kind": "raw", "role": "member",
     "request": {"body": {"resolve": {}}, "version": "HTTP/1.0"},
     "expect": {"status": 400, "refusal": "malformed"}},

    {"id": "provider-declared-origin-upper-case-host", "kind": "provider", "role": "member",
     "origin": "upper_origin", "path": "allowed_path",
     "expect": {"outcome": "response", "status": 200},
     "cache": [{"op": "put", "key": "items"}]},
    {"id": "provider-second-member-partition", "kind": "provider", "role": "second_member",
     "origin": "origin", "path": "allowed_path",
     "expect": {"outcome": "response", "status": 200},
     "distinct_from": ["provider-declared-origin-upper-case-host"],
     "cache": [{"op": "get", "key": "items", "expect": "miss"},
               {"op": "put", "key": "items"},
               {"op": "get", "key": "items", "from_case": "provider-declared-origin-upper-case-host", "expect": "hit"}]},
    {"id": "provider-undeclared-origin-refused", "kind": "provider", "role": "member",
     "origin": "undeclared_origin", "path": "allowed_path",
     "expect": {"outcome": "origin_refused"}},
    {"id": "provider-plain-http-refused", "kind": "provider", "role": "member",
     "origin": "origin", "scheme": "http", "path": "allowed_path",
     "expect": {"outcome": "origin_refused"}},
    {"id": "provider-redirect-refused", "kind": "provider", "role": "member",
     "origin": "origin", "path": "redirect_path",
     "expect": {"outcome": "redirect_refused", "status": 302}},

    {"id": "barrier-reimport", "kind": "barrier", "barrier": "reimport"},
    {"id": "provider-after-reimport-new-partition", "kind": "provider", "role": "member",
     "origin": "origin", "path": "allowed_path", "expect_from": {"barrier": "reimport"},
     "expect": {"outcome": "response", "status": 200},
     "distinct_from": ["provider-declared-origin-upper-case-host"],
     "cache": [{"op": "get", "key": "items", "expect": "miss"},
               {"op": "put", "key": "items"}]},
    {"id": "barrier-disable", "kind": "barrier", "barrier": "disable"},
    {"id": "provider-after-disable-refused", "kind": "provider", "role": "member",
     "origin": "origin", "path": "allowed_path", "expect_from": {"barrier": "disable"},
     "expect": {"outcome": "resolver_refused"},
     "cache": [{"op": "get", "key": "items", "from_case": "provider-declared-origin-upper-case-host", "expect": "hit"},
               {"op": "get", "key": "items", "from_case": "provider-after-reimport-new-partition", "expect": "hit"}]}
  ]
}
