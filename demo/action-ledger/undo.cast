{"version":3,"term":{"cols":104,"rows":34},"timestamp":1787363859,"command":"env PYTHONWARNINGS=ignore uv run --project apps/worker --with pyyaml python demo/action-ledger/run_demo.py","env":{"SHELL":"/bin/zsh"}}
[0.826, "o", "\u001b[1mAn SRE bot is about to change production.\u001b[0m\r\n"]
[0.355, "o", "\u001b[2mpublic/api is running 3 replicas.\u001b[0m\r\n"]
[0.353, "o", "\r\n"]
[0.355, "o", "\u001b[1m[1] the agent scales it, and the connector reports what it read\u001b[0m\r\n"]
[0.353, "o", "    \u001b[2m{\"ok\": true, \"prior\": {\"spec\": {\"replicas\": 3}}, \"summary\": \"scaled public/api from 3 to 10\", \"target\": {\"name\": \"api\", \"namespace\": \"public\"}}\u001b[0m\r\n"]
[0.351, "o", "    live cluster: public/api = \u001b[33m10\u001b[0m\r\n"]
[0.354, "o", "\r\n"]
[0.351, "o", "\u001b[1m[2] the runner turns that into an action, the API records it\u001b[0m\r\n"]
[0.387, "o", "    \u001b[36mPOST /actions\u001b[0m -> 26006611-47ed-4f5b-90c4-d16f5ed8245d\r\n"]
[0.355, "o", "    snapshot = {\"spec\": {\"replicas\": 3}}   undoable = \u001b[32mTrue\u001b[0m\r\n"]
[0.367, "o", "    \u001b[36mPOST /actions\u001b[0m -> ff33d2ee-8314-40b6-a067-d5c2df8c9bff\r\n"]
[0.351, "o", "    snapshot = null                       undoable = \u001b[31mFalse\u001b[0m  \u001b[2m(prose reply, nothing to restore)\u001b[0m\r\n"]
[0.355, "o", "\r\n"]
[0.355, "o", "\u001b[1m[3] the receipt the on-call sees\u001b[0m\r\n"]
[0.365, "o", "    *Did 2 things to your systems, 1 undoable*\u001b[0m\u001b[32m\u001b[0m\r\n"]
[0.355, "o", "    \u001b[32mscaled public/api from 3 to 10\u001b[0m\u001b[32m  [ Undo ]\u001b[0m\r\n"]
[0.352, "o", "    restarted public/api\u001b[0m\u001b[32m\u001b[0m\r\n"]
[0.354, "o", "    \u001b[2mrestarting pods cannot be undone\u001b[0m\u001b[32m\u001b[0m\r\n"]
[0.355, "o", "\r\n"]
[0.355, "o", "\u001b[1m[4] someone presses Undo\u001b[0m\r\n"]
[0.369, "o", "    \u001b[36mPOST /actions/{id}/undo\u001b[0m -> 200\r\n"]
[0.351, "o", "    \u001b[32mrestored: public/api = 3\u001b[0m\r\n"]
[0.355, "o", "\r\n"]
[0.354, "o", "\u001b[1m[5] the same button, after a human already fixed it by hand\u001b[0m\r\n"]
[0.369, "o", "    \u001b[2mthe bot scaled it again; action 6040c759 recorded\u001b[0m\r\n"]
[0.355, "o", "    \u001b[33ma human sets it to 7\u001b[0m\r\n"]
[0.366, "o", "    \u001b[36mPOST /actions/{id}/undo\u001b[0m -> \u001b[31m409\u001b[0m the target changed since this action; refusing to restore over it\r\n"]
[0.355, "o", "    \u001b[32mpublic/api = 7\u001b[0m  \u001b[2mthe manual fix survives\u001b[0m\r\n"]
[0.363, "o", "    \u001b[2maudit: refused -- {\"expected\": {\"spec\": {\"replicas\": 10}}, \"observed\": {\"spec\": {\"replicas\": 7}}}\u001b[0m\r\n"]
[0.641, "x", "0"]
