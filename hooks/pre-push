#!/usr/bin/env python3
"""Check formatting and lint for source files touched by pushed commits."""

from __future__ import annotations

import os
import shlex
import subprocess
import sys
from pathlib import Path


def git(root: Path, *args: str) -> bytes:
    result = subprocess.run(["git", *args], cwd=root, capture_output=True, check=False)
    if result.returncode:
        detail = result.stderr.decode(errors="replace").strip()
        raise RuntimeError(f"git {' '.join(args)} failed: {detail}")
    return result.stdout


def remote_commits(root: Path, remote_name: str) -> list[str]:
    """Use locally known remote tips for a newly created remote ref."""
    output = git(
        root,
        "for-each-ref",
        "--format=%(objectname)",
        f"refs/remotes/{remote_name}/",
    )
    return [line.decode("ascii") for line in output.splitlines()]


def pushed_commits(root: Path, local_sha: str, remote_sha: str, remote_name: str) -> list[str]:
    local_commit = git(root, "rev-parse", "--verify", f"{local_sha}^{{commit}}")
    local_commit = local_commit.decode("ascii").strip()

    if set(remote_sha) == {"0"}:
        exclusions = remote_commits(root, remote_name)
    else:
        remote_commit = subprocess.run(
            ["git", "rev-parse", "--verify", f"{remote_sha}^{{commit}}"],
            cwd=root,
            capture_output=True,
            check=False,
        )
        if remote_commit.returncode:
            raise RuntimeError(
                f"remote commit {remote_sha} is unavailable locally; fetch the remote ref first"
            )
        exclusions = [remote_commit.stdout.decode("ascii").strip()]

    command = ["rev-list", local_commit]
    if exclusions:
        command.extend(["--not", *exclusions])
    return [line.decode("ascii") for line in git(root, *command).splitlines()]


def changed_paths(root: Path, commits: set[str]) -> set[str]:
    paths: set[str] = set()
    for commit in commits:
        output = git(
            root,
            "diff-tree",
            "--root",
            "--no-commit-id",
            "--name-only",
            "--diff-filter=ACMR",
            "-r",
            "-m",
            "-z",
            commit,
        )
        paths.update(os.fsdecode(path) for path in output.split(b"\0") if path)
    return paths


def check_pushed_content_matches_worktree(root: Path, tip: str, paths: set[str]) -> None:
    if not paths:
        return
    head = git(root, "rev-parse", "HEAD").decode("ascii").strip()
    if tip != head:
        raise RuntimeError("push the checked out HEAD so its source can be verified")
    result = subprocess.run(
        ["git", "diff", "--quiet", tip, "--", *sorted(paths)],
        cwd=root,
        check=False,
    )
    if result.returncode:
        raise RuntimeError(
            "a pushed source file differs from the current worktree; "
            "commit or restore those changes before pushing"
        )


def run_check(command: list[str], cwd: Path, fix: str) -> bool:
    try:
        result = subprocess.run(command, cwd=cwd, check=False)
    except OSError as error:
        print(
            f"pre-push: cannot run {shlex.join(command)}: {error}\nFix: {fix}",
            file=sys.stderr,
        )
        return False
    if result.returncode:
        print(f"pre-push: check failed. Fix: {fix}", file=sys.stderr)
        return False
    return True


def main() -> int:
    try:
        root = Path(git(Path.cwd(), "rev-parse", "--show-toplevel").decode().strip())
        remote_name = sys.argv[1] if len(sys.argv) > 1 else ""
        commits: set[str] = set()
        for line in sys.stdin:
            fields = line.split()
            if len(fields) != 4:
                raise RuntimeError(f"invalid pre-push ref line: {line.rstrip()!r}")
            _, local_sha, _, remote_sha = fields
            if set(local_sha) == {"0"}:
                continue  # Deleting a remote ref sends no source files.
            ref_commits = set(pushed_commits(root, local_sha, remote_sha, remote_name))
            ref_paths = changed_paths(root, ref_commits)
            checked_paths = {
                path
                for path in ref_paths
                if path.endswith((".py", ".pyi"))
                or (path.startswith("cli/") and path.endswith(".rs"))
            }
            commit_tip = git(root, "rev-parse", "--verify", f"{local_sha}^{{commit}}")
            check_pushed_content_matches_worktree(
                root, commit_tip.decode("ascii").strip(), checked_paths
            )
            commits.update(ref_commits)
        paths = changed_paths(root, commits)
    except (OSError, RuntimeError, UnicodeError) as error:
        print(f"pre-push: cannot inspect pushed commits: {error}", file=sys.stderr)
        return 1

    rust_changed = any(path.startswith("cli/") and path.endswith(".rs") for path in paths)
    python_files = sorted(
        f"./{path}"
        for path in paths
        if path.endswith((".py", ".pyi"))
        and (root / path).is_file()
        and not (root / path).is_symlink()
    )

    passed = True
    if rust_changed:
        passed &= run_check(["cargo", "fmt", "--check"], root / "cli", "cd cli && cargo fmt")
    if python_files:
        passed &= run_check(
            ["uv", "run", "ruff", "format", "--force-exclude", "--check", *python_files],
            root,
            shlex.join(["uv", "run", "ruff", "format", "--force-exclude", *python_files]),
        )
        passed &= run_check(
            ["uv", "run", "ruff", "check", "--force-exclude", *python_files],
            root,
            shlex.join(["uv", "run", "ruff", "check", "--force-exclude", "--fix", *python_files]),
        )
    return 0 if passed else 1


if __name__ == "__main__":
    sys.exit(main())
