{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": ".*get_issue",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PLUGIN_ROOT}/hooks/selector_gate.py",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PLUGIN_ROOT}/hooks/selector_gate.py",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
