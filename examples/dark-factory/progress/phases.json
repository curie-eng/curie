{
  "phases": [
    {"id": "read_issue", "label": "Read issue"},
    {"id": "pin_criteria", "label": "Pin acceptance criteria"},
    {"id": "plan", "label": "Plan"},
    {"id": "plan_review", "label": "Plan review"},
    {"id": "failing_test", "label": "Failing test"},
    {"id": "implement", "label": "Implement"},
    {"id": "review_diff", "label": "Review diff"},
    {"id": "publish", "label": "Publish PR"},
    {"id": "wait_ci", "label": "Wait for CI"}
  ],
  "loops": [
    {"start": "plan", "review": "plan_review", "cap": 1},
    {"start": "implement", "review": "review_diff", "cap": 5},
    {"start": "implement", "review": "wait_ci", "cap": 3}
  ],
  "reviewer_model": "openai/gpt-6.1-sol",
  "stages": [
    {"id": "read_issue", "label": "Reading the issue", "phases": ["read_issue", "pin_criteria"]},
    {"id": "plan", "label": "Planning the change", "phases": ["plan"]},
    {"id": "plan_review", "label": "Reviewing the plan", "phases": ["plan_review"]},
    {"id": "implement", "label": "Writing the change", "phases": ["failing_test", "implement"]},
    {"id": "review_diff", "label": "Reviewing the diff", "phases": ["review_diff"]},
    {"id": "publish", "label": "Opening the pull request", "phases": ["publish"]},
    {"id": "wait_ci", "label": "Waiting for CI", "phases": ["wait_ci"]}
  ]
}
