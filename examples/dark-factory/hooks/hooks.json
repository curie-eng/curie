{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {"type": "command", "command": "python3 ${CLAUDE_PLUGIN_ROOT}/hooks/review_gate.py", "timeout": 10}
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Agent|Task|Bash|Edit|Write|MultiEdit|NotebookEdit|.*publish_changes|.*report_progress",
        "hooks": [
          {"type": "command", "command": "python3 ${CLAUDE_PLUGIN_ROOT}/hooks/review_gate.py", "timeout": 10}
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Agent|Task|Skill|Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {"type": "command", "command": "python3 ${CLAUDE_PLUGIN_ROOT}/hooks/review_gate.py", "timeout": 10}
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Agent|Task|Bash",
        "hooks": [
          {"type": "command", "command": "python3 ${CLAUDE_PLUGIN_ROOT}/hooks/review_gate.py", "timeout": 10}
        ]
      }
    ]
  }
}
