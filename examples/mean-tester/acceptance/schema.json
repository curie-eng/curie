{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/agent-acceptance-v1.schema.json",
  "title": "Target-owned acceptance suite, separate from platform eval cases",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "name",
    "criteria",
    "cases"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "description"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/case"
      }
    }
  },
  "$defs": {
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "probe",
        "mode",
        "attachments",
        "expected_reply",
        "card_action",
        "expected_state",
        "criterion",
        "priority",
        "repeat"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "probe": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "enum": [
            "read-or-ask",
            "action"
          ]
        },
        "attachments": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "expected_reply": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "card_action": {
          "enum": [
            null,
            "approve",
            "reject",
            "click-as-non-approver"
          ]
        },
        "expected_state": {
          "type": [
            "object",
            "null"
          ]
        },
        "criterion": {
          "type": "string",
          "minLength": 1
        },
        "priority": {
          "enum": [
            "P0",
            "P1"
          ]
        },
        "repeat": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      }
    }
  }
}
