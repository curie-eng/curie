  "tiers": {
    "skill": {
      "required": true,
      "setupAndProof": "Externally hosted connectors at the same pinned images and flags, unhosted URLs and protected credentials. Prove actual tools, read, pending mutation, denial and fresh approval."
    },
    "local": {
      "required": true,
      "setupAndProof": "Same immutable bundle and eval suite through Compose worker and API. Externally host connectors where local hosting is unavailable; preserve the same capabilities."
    },
    "local-release": {
      "required": true,
      "setupAndProof": "Repeat local observations using published binary and images; record bundle and eval digests and resource availability from the released installer."
    },
    "cluster": {
      "required": true,
      "setupAndProof": "Supported example install with disposable workloads and real connector identities. Verify CronJobs exist before arming either upgrade verb; prove RBAC refusal after approval."
    },
    "live provider": {
      "required": true,
      "setupAndProof": "Real SDK catalog visibility and approval scheduling on each applicable tier. Fake model and HTTP catalog fixtures never prove this row."
    },
    "external integration": {
      "required": true,
      "setupAndProof": "Real MCP tools and Slack cards, genuine human decisions, readback and fresh approval. Verify upstream state, refusal and unchanged state on denial."
    }
  }
