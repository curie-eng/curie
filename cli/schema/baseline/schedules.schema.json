{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.curietech.ai/cli/schedules/v3.1.json",
  "title": "curie <tier> schedules --json",
  "description": "The agent-facing payload of `curie <tier> schedules`: the dry-run plan, or cron hooks on each in-force deployment. `last_fire_at`, `last_outcome`, and `last_reason` describe the newest scheduled run. The `last_manual_*` fields describe the newest manual fire independently. An absent history group or open outcome is null. `agent_schedules` (ADR 0248) lists the schedules agents and operators created, as the API sent them. The agent-schedule verbs print one schedule, `{revisions}` for `--history`, or `{agent, policy}` for a policy setter, where `policy` is the agent's schedule settings as the API stored them.",
  "$defs": {
    "dryRun": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dry_run": {
          "const": true
        },
        "plan": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "dry_run",
        "plan"
      ]
    },
    "hook": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "trigger": {
          "type": "string"
        },
        "schedule": {
          "type": "string"
        },
        "zone": {
          "type": "string"
        },
        "last_fire_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "last_outcome": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "enum": [
                "ran",
                "deferred",
                "skipped",
                "blocked",
                "reclaimed",
                "failed"
              ]
            }
          ]
        },
        "last_reason": {
          "type": ["string", "null"]
        },
        "last_manual_fire_at": {
          "type": ["string", "null"]
        },
        "last_manual_outcome": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "enum": [
                "ran",
                "deferred",
                "skipped",
                "blocked",
                "reclaimed",
                "failed"
              ]
            }
          ]
        },
        "last_manual_reason": {
          "type": ["string", "null"]
        },
        "paused": {
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "trigger",
        "schedule",
        "zone",
        "last_fire_at",
        "last_outcome",
        "last_manual_fire_at",
        "last_manual_outcome",
        "last_manual_reason",
        "paused"
      ]
    },
    "control": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "agent": { "type": "string" },
        "name": { "type": "string" },
        "paused": { "type": "boolean" }
      },
      "required": ["agent", "name", "paused"]
    },
    "agentSchedule": {
      "type": "object",
      "required": ["id", "state"],
      "properties": {
        "id": { "type": "string" },
        "state": { "type": "string" }
      }
    },
    "agentScheduleRevisions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "revisions": {
          "type": "array",
          "items": { "type": "object" }
        }
      },
      "required": ["revisions"]
    },
    "agentSchedulePolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "agent": { "type": "string" },
        "policy": { "type": "object" }
      },
      "required": ["agent", "policy"]
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "agent": {
          "type": "string"
        },
        "agent_id": {
          "type": "string"
        },
        "bundle_error": {
          "type": [
            "string",
            "null"
          ]
        },
        "hooks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/hook"
          }
        }
      },
      "required": [
        "agent",
        "agent_id",
        "bundle_error",
        "hooks"
      ]
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/dryRun"
    },
    {
      "$ref": "#/$defs/control"
    },
    {
      "$ref": "#/$defs/agentSchedule"
    },
    {
      "$ref": "#/$defs/agentScheduleRevisions"
    },
    {
      "$ref": "#/$defs/agentSchedulePolicy"
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schedules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/agent"
          }
        },
        "agent_schedules": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      },
      "required": [
        "schedules"
      ]
    }
  ]
}
