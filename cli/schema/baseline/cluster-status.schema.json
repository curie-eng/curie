{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.curietech.ai/cli/cluster-status/v1.6.json",
  "title": "curie cluster status --json",
  "description": "The agent-facing payload of `curie cluster status`: the dry-run plan, or the release's revision, pod readiness roll-up (with per-pod rows and the unhealthy names), discovered service URLs (a degraded surface carries a `note` and a null `url`), any `warnings` (diagnoses that could not be made, which never affect `healthy`), completion-delivery health, an overall `healthy` verdict, the current upgrade phase plus last known-good version, and each recorded forge credential's expiry.",
  "$defs": {
    "dryRun": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dry_run": {
          "const": true
        },
        "plan": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "dry_run",
        "plan"
      ]
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/dryRun"
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "namespace": {
          "type": "string"
        },
        "revision": {
          "type": "string"
        },
        "release_state": {
          "type": "string"
        },
        "release_found": {
          "type": "boolean"
        },
        "pods": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "ready": {
              "type": "integer"
            },
            "total": {
              "type": "integer"
            },
            "unhealthy": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "rows": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "pod": {
                    "type": "string"
                  },
                  "ready": {
                    "type": "string"
                  },
                  "status": {
                    "type": "string"
                  },
                  "mail_channel": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "pod": {
                        "type": "string"
                      },
                      "channel_token": {
                        "oneOf": [
                          {
                            "type": "null"
                          },
                          {
                            "type": "object",
                            "additionalProperties": false,
                            "properties": {
                              "present": {
                                "type": "boolean"
                              },
                              "exp": {
                                "type": [
                                  "integer",
                                  "null"
                                ]
                              },
                              "state": {
                                "enum": [
                                  "ok",
                                  "expiring",
                                  "expired",
                                  "rejected",
                                  "missing",
                                  "invalid",
                                  "disabled"
                                ]
                              }
                            },
                            "required": [
                              "present",
                              "exp",
                              "state"
                            ]
                          }
                        ]
                      },
                      "last_ingress_status": {
                        "type": [
                          "integer",
                          "null"
                        ]
                      },
                      "detail": {
                        "type": "string"
                      },
                      "fix": {
                        "type": [
                          "string",
                          "null"
                        ]
                      }
                    },
                    "required": [
                      "pod",
                      "channel_token",
                      "last_ingress_status",
                      "detail",
                      "fix"
                    ]
                  }
                },
                "required": [
                  "pod",
                  "ready",
                  "status"
                ]
              }
            }
          },
          "required": [
            "ready",
            "total",
            "unhealthy",
            "rows"
          ]
        },
        "urls": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string"
              },
              "url": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "note": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "name",
              "url",
              "note"
            ]
          }
        },
        "healthy": {
          "type": "boolean"
        },
        "credentials": {
          "description": "Each forge credential recorded under the release's factory.codeHosts and factory.trackers (#4397), with its expiry: `known` (with `expires_at`), `unknown` (the type can expire but none was recorded) or `none`. `warning` is set when a known expiry is past or at most 14 days away, and the same text is in `warnings`. Empty with no factory block.",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "section": {
                "enum": [
                  "code_host",
                  "tracker"
                ]
              },
              "name": {
                "type": "string"
              },
              "type": {
                "type": "string"
              },
              "expiry": {
                "enum": [
                  "known",
                  "unknown",
                  "none"
                ]
              },
              "expires_at": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date-time"
              },
              "warning": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "authentication": {
                "description": "Whether the forge accepted the credential at the API's last probe (#4630): `accepted`, `rejected` (also listed in `pods.unhealthy`, so `healthy` is false) or `unknown`. Separate from expiry.",
                "enum": [
                  "accepted",
                  "rejected",
                  "unknown"
                ]
              },
              "authentication_reason": {
                "description": "Why authentication is rejected or unknown, for example `unauthorized`, `credential_unreadable`, `not_probed`, or `api_unavailable` when the API report could not be read. Null when accepted.",
                "type": [
                  "string",
                  "null"
                ]
              },
              "observed_at": {
                "description": "When the API probed the credential; null when it was not read.",
                "type": [
                  "string",
                  "null"
                ],
                "format": "date-time"
              }
            },
            "required": [
              "section",
              "name",
              "type",
              "expiry",
              "expires_at",
              "warning"
            ]
          }
        },
        "upgrade": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "phase": {
              "type": [
                "string",
                "null"
              ]
            },
            "status": {
              "type": "string"
            },
            "known_good_version": {
              "type": [
                "string",
                "null"
              ]
            },
            "target_version": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "phase",
            "status",
            "known_good_version",
            "target_version"
          ]
        },
        "warnings": {
          "description": "Diagnoses the command could not make, as opposed to defects it found. A mail adapter whose /statusz could not be read appears here. Never affects `healthy` or the exit code.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "delivery": {
          "description": "Completion-outbox inventory from the worker. Count, oldest age, and retry/terminal state. Identifiers are omitted. A retrying owed completion makes `healthy` false even when pods are ready and stream lag is zero.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "count": {
              "type": "integer"
            },
            "oldest_age_s": {
              "type": "number"
            },
            "inflight": {
              "type": "integer"
            },
            "retry": {
              "type": "integer"
            },
            "terminal": {
              "type": "integer"
            },
            "state": {
              "enum": [
                "empty",
                "inflight",
                "retry",
                "unknown"
              ]
            },
            "degraded": {
              "type": "boolean"
            },
            "detail": {
              "type": "string"
            }
          },
          "required": [
            "count",
            "oldest_age_s",
            "inflight",
            "retry",
            "terminal",
            "state",
            "degraded",
            "detail"
          ]
        }
      },
      "required": [
        "namespace",
        "revision",
        "release_state",
        "release_found",
        "pods",
        "urls",
        "healthy"
      ]
    }
  ]
}
