{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.curietech.ai/cli/factory-progress/v1.json",
  "title": "curie <tier> factory-progress --json",
  "description": "The agent-facing payload of `curie <tier> factory-progress <agent>`: the dry-run plan, or the Slack channel one agent's factory runs post progress to, as the API stored it. `factory_slack_channel` is the configured progress channel, and null when none is configured. `changed` is false for an inspect and true when this invocation wrote.",
  "$defs": {
    "dryRun": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dry_run": {
          "const": true
        },
        "plan": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "dry_run",
        "plan"
      ]
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/dryRun"
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "agent": {
          "type": "string"
        },
        "factory_slack_channel": {
          "type": ["string", "null"]
        },
        "changed": {
          "type": "boolean"
        }
      },
      "required": [
        "agent",
        "factory_slack_channel",
        "changed"
      ]
    }
  ]
}
