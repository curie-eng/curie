{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.curietech.ai/cli/factory-progress/v1.1.json",
  "title": "curie <tier> factory-progress --json",
  "description": "The stored progress channel and workspace-public run channel for the agent. A null channel is unconfigured. A write sets changed to true.",
  "$defs": {
    "dryRun": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dry_run": {
          "const": true
        },
        "plan": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "dry_run",
        "plan"
      ]
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/dryRun"
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "agent": {
          "type": "string"
        },
        "factory_slack_channel": {
          "type": ["string", "null"]
        },
        "factory_public_slack_channel": {
          "type": ["string", "null"]
        },
        "changed": {
          "type": "boolean"
        }
      },
      "required": [
        "agent",
        "factory_slack_channel",
        "changed"
      ]
    }
  ]
}
