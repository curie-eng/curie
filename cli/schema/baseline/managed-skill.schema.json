{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.curietech.ai/cli/managed-skill/v1.json",
  "title": "Managed text-skill update, resolution and package result",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "current_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "available_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "preparation_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "contract_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "instructions_path": {
      "type": [
        "string",
        "null"
      ]
    },
    "preferences_path": {
      "type": [
        "string",
        "null"
      ]
    },
    "backup_path": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "enum": [
        "current",
        "update-available",
        "updated",
        "rolled-back",
        "resolved",
        "packaged",
        "offline",
        "planned"
      ]
    },
    "dry_run": {
      "type": "boolean"
    },
    "directory": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "current_version",
    "available_version",
    "preparation_version",
    "contract_version",
    "instructions_path",
    "preferences_path",
    "backup_path",
    "status",
    "dry_run",
    "directory"
  ]
}
