{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.curietech.ai/cli/lint-values/v1.json",
  "title": "curie cluster lint-values --json",
  "description": "Paths whose effective values differ between the stored release and pending values files. Values are never included.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "changed_paths": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "changed_count": {
      "type": "integer",
      "minimum": 0
    },
    "release_exists": {
      "type": "boolean"
    }
  },
  "required": [
    "changed_paths",
    "changed_count",
    "release_exists"
  ]
}
