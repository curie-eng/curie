{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.curietech.ai/cli/hook-fire/v1.json",
  "title": "curie <tier> hook fire --json",
  "description": "The agent-facing payload of `curie local hook fire` and `curie cluster hook fire`: the dry-run plan, or the run record once the turn has settled.",
  "$defs": {
    "dryRun": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dry_run": { "const": true },
        "plan": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["dry_run", "plan"]
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "agent_id": { "type": "string" },
        "agent": { "type": "string" },
        "name": { "type": "string" },
        "trigger": { "type": "string" },
        "slot_utc": { "type": "string" },
        "outcome": { "type": ["string", "null"] },
        "started_at": { "type": "string" },
        "ended_at": { "type": ["string", "null"] }
      },
      "required": ["id", "agent_id", "agent", "name", "trigger", "slot_utc", "outcome", "started_at", "ended_at"]
    }
  },
  "oneOf": [
    { "$ref": "#/$defs/dryRun" },
    { "$ref": "#/$defs/record" }
  ]
}
