{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.curietech.ai/cli/memory/v2.json",
  "title": "curie <tier> memory --json",
  "description": "The agent-facing payload of `curie <tier> memory <agent>` and `curie <tier> memory <agent> --add <content>`: the dry-run plan, the learned-memory entries (an empty array when none exist), or the operator-seeded add result.",
  "$defs": {
    "dryRun": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dry_run": {
          "const": true
        },
        "plan": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "dry_run",
        "plan"
      ]
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/dryRun"
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "agent": {
          "type": "string"
        },
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "index": {
                "type": "integer"
              },
              "content": {
                "type": "string"
              }
            },
            "required": [
              "index",
              "content"
            ]
          }
        }
      },
      "required": [
        "agent",
        "entries"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "agent": {
          "type": "string"
        },
        "index": {
          "type": "integer"
        },
        "content": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "fresh_session_required": {
          "const": true
        },
        "next_command": {
          "type": "string"
        }
      },
      "required": [
        "agent",
        "index",
        "content",
        "source",
        "fresh_session_required",
        "next_command"
      ]
    }
  ]
}
