{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.curietech.ai/cli/memory/v3.json",
  "title": "curie <tier> memory --json",
  "description": "The payload of `curie <tier> memory <agent>` and its channel, delete, add, guidance, and lifecycle flags: a dry run plan, the retained memory log and attributed individual facts, a confirmed deletion, an operator seeded add result, the effective memory guidance, an archived or restored entry (`--archive`, `--restore`, shaped as the API's MemoryRecordOut), or an entry with its newest revisions (`--history`, `--revert`, shaped as the API's MemoryDetailOut). Each listed fact carries its author and stated_at (null when the stored fact never recorded them), its kind (fact or instruction), title, conversation (null when unknown), archived flag, and head version (ADR 0239). Lists always emit facts, including an empty array; facts is optional in the schema to retain validity of prior list payloads.",
  "$defs": {
    "dryRun": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dry_run": {
          "const": true
        },
        "plan": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "dry_run",
        "plan"
      ]
    },
    "channel": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string"
        },
        "address": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "address"
      ]
    },
    "kind": {
      "enum": [
        "fact",
        "instruction"
      ]
    },
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "scope": {
          "enum": [
            "agent",
            "channel"
          ]
        },
        "channel": {
          "$ref": "#/$defs/channel"
        },
        "kind": {
          "$ref": "#/$defs/kind"
        },
        "title": {
          "type": "string"
        },
        "statement": {
          "type": "string"
        },
        "author": {
          "type": [
            "string",
            "null"
          ]
        },
        "stated_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "conversation": {
          "type": [
            "string",
            "null"
          ]
        },
        "archived": {
          "type": "boolean"
        },
        "version": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "id",
        "scope",
        "channel",
        "kind",
        "title",
        "statement",
        "author",
        "stated_at",
        "conversation",
        "archived",
        "version"
      ]
    },
    "record": {
      "description": "One canonical memory head (MemoryRecordOut).",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "scope": {
          "enum": [
            "agent",
            "channel"
          ]
        },
        "kind": {
          "$ref": "#/$defs/kind"
        },
        "title": {
          "type": "string"
        },
        "statement": {
          "type": "string"
        },
        "author": {
          "type": [
            "string",
            "null"
          ]
        },
        "stated_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "conversation": {
          "type": [
            "string",
            "null"
          ]
        },
        "archived": {
          "type": "boolean"
        },
        "version": {
          "type": "integer",
          "minimum": 0
        },
        "updated_at": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "scope",
        "kind",
        "title",
        "statement",
        "author",
        "stated_at",
        "conversation",
        "archived",
        "version",
        "updated_at"
      ]
    },
    "revision": {
      "description": "One immutable revision (MemoryRevisionOut). snapshot is the resulting canonical value, null for a deletion.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": {
          "type": "integer",
          "minimum": 0
        },
        "operation": {
          "enum": [
            "baseline",
            "create",
            "update",
            "delete",
            "archive",
            "restore",
            "revert"
          ]
        },
        "actor": {
          "type": "string"
        },
        "source": {
          "enum": [
            "sandbox",
            "operator",
            "migration"
          ]
        },
        "conversation": {
          "type": [
            "string",
            "null"
          ]
        },
        "created_at": {
          "type": "string"
        },
        "reverted_to_version": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "snapshot": {
          "type": [
            "object",
            "null"
          ]
        }
      },
      "required": [
        "version",
        "operation",
        "actor",
        "source",
        "conversation",
        "created_at",
        "reverted_to_version",
        "snapshot"
      ]
    },
    "detail": {
      "description": "A canonical memory entry with its newest revisions (MemoryDetailOut). entry is null and deleted is true when the head was forgotten or reverted to absence; version is then the latest revision's version.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "entry": {
          "oneOf": [
            {
              "$ref": "#/$defs/record"
            },
            {
              "type": "null"
            }
          ]
        },
        "deleted": {
          "type": "boolean"
        },
        "version": {
          "type": "integer",
          "minimum": 0
        },
        "history": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/revision"
          }
        },
        "history_before": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      },
      "required": [
        "entry",
        "deleted",
        "version",
        "history",
        "history_before"
      ]
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/dryRun"
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "agent": {
          "type": "string"
        },
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "index": {
                "type": "integer"
              },
              "content": {
                "type": "string"
              }
            },
            "required": [
              "index",
              "content"
            ]
          }
        },
        "facts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fact"
          }
        }
      },
      "required": [
        "agent",
        "entries"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "agent": {
          "type": "string"
        },
        "index": {
          "type": "integer"
        },
        "content": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "fresh_session_required": {
          "const": true
        },
        "next_command": {
          "type": "string"
        }
      },
      "required": [
        "agent",
        "index",
        "content",
        "source",
        "fresh_session_required",
        "next_command"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "agent": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "source": {
          "enum": [
            "default",
            "learning_default",
            "operator"
          ]
        },
        "changed": {
          "type": "boolean"
        }
      },
      "required": [
        "agent",
        "text",
        "source",
        "changed"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "agent": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "scope": {
          "enum": [
            "agent",
            "channel"
          ]
        },
        "channel": {
          "$ref": "#/$defs/channel"
        },
        "deleted": {
          "const": true
        }
      },
      "required": [
        "agent",
        "id",
        "scope",
        "channel",
        "deleted"
      ]
    },
    {
      "$ref": "#/$defs/record"
    },
    {
      "$ref": "#/$defs/detail"
    }
  ]
}
