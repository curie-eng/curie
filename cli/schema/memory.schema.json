{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.curietech.ai/cli/memory/v2.2.json",
  "title": "curie <tier> memory --json",
  "description": "The payload of `curie <tier> memory <agent>` and its channel, delete, add, and guidance flags: a dry run plan, the retained memory log and attributed individual facts, a confirmed deletion, an operator seeded add result, or the effective memory guidance. Lists always emit facts, including an empty array; facts is optional in the schema to retain validity of prior list payloads.",
  "$defs": {
    "dryRun": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dry_run": {
          "const": true
        },
        "plan": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "dry_run",
        "plan"
      ]
    },
    "channel": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string"
        },
        "address": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "address"
      ]
    },
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "scope": {
          "enum": [
            "agent",
            "channel"
          ]
        },
        "channel": {
          "$ref": "#/$defs/channel"
        },
        "statement": {
          "type": "string"
        },
        "author": {
          "type": "string"
        },
        "stated_at": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "scope",
        "channel",
        "statement",
        "author",
        "stated_at"
      ]
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/dryRun"
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "agent": {
          "type": "string"
        },
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "index": {
                "type": "integer"
              },
              "content": {
                "type": "string"
              }
            },
            "required": [
              "index",
              "content"
            ]
          }
        },
        "facts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fact"
          }
        }
      },
      "required": [
        "agent",
        "entries"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "agent": {
          "type": "string"
        },
        "index": {
          "type": "integer"
        },
        "content": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "fresh_session_required": {
          "const": true
        },
        "next_command": {
          "type": "string"
        }
      },
      "required": [
        "agent",
        "index",
        "content",
        "source",
        "fresh_session_required",
        "next_command"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "agent": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "source": {
          "enum": [
            "default",
            "operator"
          ]
        },
        "changed": {
          "type": "boolean"
        }
      },
      "required": [
        "agent",
        "text",
        "source",
        "changed"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "agent": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "scope": {
          "enum": [
            "agent",
            "channel"
          ]
        },
        "channel": {
          "$ref": "#/$defs/channel"
        },
        "deleted": {
          "const": true
        }
      },
      "required": [
        "agent",
        "id",
        "scope",
        "channel",
        "deleted"
      ]
    }
  ]
}
