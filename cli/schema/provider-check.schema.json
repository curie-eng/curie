{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.curietech.ai/cli/provider-check/v1.1.json",
  "title": "curie secrets check --json",
  "description": "Expiry, missing keys, stale consumers, and provider version metadata. Values are never emitted.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "checked": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "version": { "type": "string" },
          "expires_at": { "type": ["string", "null"], "format": "date-time" },
          "status": { "enum": ["ok", "warning", "expired", "missing", "stale"] },
          "missing_keys": { "type": "array", "items": { "type": "string" } },
          "stale_consumers": { "type": "array", "items": { "type": "string" } }
        },
        "required": ["name", "version", "expires_at", "status"]
      }
    }
  },
  "required": ["checked"]
}
