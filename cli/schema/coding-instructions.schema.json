{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.curietech.ai/cli/coding-instructions/v1.0.json",
  "title": "curie cluster coding-instructions --json",
  "description": "The owner coding instructions response or an offline request plan. Application to factory runs is unavailable.",
  "$defs": {
    "dryRun": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dry_run": { "const": true },
        "plan": { "type": "array", "items": { "type": "string" } },
        "application": { "const": "unavailable" }
      },
      "required": ["dry_run", "plan", "application"]
    },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "sha256": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{64}$"
        },
        "format_version": { "const": 1 },
        "byte_length": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16384
        },
        "text": { "type": ["string", "null"] },
        "updated_at": { "type": ["string", "null"], "format": "date-time" },
        "tenant_enabled": { "type": "boolean" },
        "application": { "const": "unavailable" }
      },
      "required": [
        "revision",
        "sha256",
        "format_version",
        "byte_length",
        "text",
        "updated_at",
        "tenant_enabled",
        "application"
      ]
    }
  },
  "oneOf": [
    { "$ref": "#/$defs/dryRun" },
    { "$ref": "#/$defs/document" }
  ]
}
