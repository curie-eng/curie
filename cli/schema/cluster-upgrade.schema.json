{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.curietech.ai/cli/cluster-upgrade/v1.1.json",
  "title": "curie cluster upgrade --json",
  "description": "The agent-facing payload of `curie cluster upgrade`: the redacted dry-run plan, or the completed lifecycle (succeeded or failed). Success requires exact convergence and a passing API/storage identity canary. A failure records the last known-good version and recovery instructions; it does not guarantee that version remains serving.",
  "$defs": {
    "dryRun": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dry_run": {
          "const": true
        },
        "plan": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "dry_run",
        "plan"
      ]
    },
    "convergence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "exact": {
          "type": "boolean"
        },
        "images": {
          "type": "boolean"
        },
        "generations": {
          "type": "boolean"
        },
        "replicas": {
          "type": "boolean"
        },
        "unavailable_zero": {
          "type": "boolean"
        },
        "hooks_healthy": {
          "type": "boolean"
        },
        "queues_drained": {
          "type": "boolean"
        },
        "manifest_matches": {
          "type": "boolean"
        },
        "observed_images": {
          "type": "array",
          "description": "Actual Pod/container image observations; image_id is opaque runtime evidence, not proof of registry digest equivalence. Optional for compatibility with older CLI reports.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "workload": {
                "type": "string"
              },
              "pod": {
                "type": "string"
              },
              "container": {
                "type": "string"
              },
              "image": {
                "type": "string"
              },
              "image_id": {
                "type": "string"
              }
            },
            "required": [
              "workload",
              "pod",
              "container",
              "image",
              "image_id"
            ]
          }
        }
      },
      "required": [
        "exact",
        "images",
        "generations",
        "replicas",
        "unavailable_zero",
        "hooks_healthy",
        "queues_drained",
        "manifest_matches"
      ]
    },
    "canary": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "passed": {
          "type": "boolean"
        }
      },
      "required": [
        "passed"
      ]
    },
    "failForward": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "command": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "command",
        "reason"
      ]
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/dryRun"
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "succeeded",
            "failed"
          ]
        },
        "phase": {
          "type": "string"
        },
        "target_version": {
          "type": "string"
        },
        "from_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "known_good_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "resumed": {
          "type": "boolean"
        },
        "previous_serving": {
          "type": "boolean"
        },
        "unchanged": {
          "type": "boolean"
        },
        "plan": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "convergence": {
          "oneOf": [
            {
              "$ref": "#/$defs/convergence"
            },
            {
              "type": "null"
            }
          ]
        },
        "canary": {
          "oneOf": [
            {
              "$ref": "#/$defs/canary"
            },
            {
              "type": "null"
            }
          ]
        },
        "fail_forward": {
          "oneOf": [
            {
              "$ref": "#/$defs/failForward"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "status",
        "phase",
        "target_version",
        "from_version",
        "known_good_version",
        "resumed",
        "previous_serving",
        "unchanged",
        "plan",
        "convergence",
        "canary",
        "fail_forward"
      ],
      "if": {
        "properties": {
          "status": {
            "const": "succeeded"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "convergence": {
            "type": "object",
            "properties": {
              "exact": {
                "const": true
              }
            },
            "required": [
              "exact"
            ]
          },
          "canary": {
            "type": "object",
            "properties": {
              "passed": {
                "const": true
              }
            },
            "required": [
              "passed"
            ]
          }
        }
      }
    }
  ]
}
