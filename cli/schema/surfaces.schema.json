{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.curietech.ai/cli/surfaces/v1.json",
  "title": "curie <tier> surfaces --json",
  "description": "The agent-facing payload of `curie <tier> surfaces <agent>`: the dry-run plan, or the agent's surface bindings as the API stored them (ADR-0116). An agent holds one or more bindings, and each is the PAIR `kind` + `address`, never a bare address: a consumer must be able to read the ingress kind without guessing it. `changed` is false for a list (no `--add`/`--remove` passed) and true when this invocation wrote, so a consumer can tell \"this is what it is\" from \"this is what it now is\" without diffing.",
  "$defs": {
    "dryRun": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dry_run": {
          "const": true
        },
        "plan": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "dry_run",
        "plan"
      ]
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string"
        },
        "address": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "address"
      ]
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/dryRun"
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "agent": {
          "type": "string"
        },
        "surfaces": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/binding"
          }
        },
        "changed": {
          "type": "boolean"
        }
      },
      "required": [
        "agent",
        "surfaces",
        "changed"
      ]
    }
  ]
}
