{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.curietech.ai/cli/factory-quickstart/v1.1.json",
  "title": "curie factory quickstart --json",
  "description": "The agent-facing payload of `curie factory quickstart`: the dry-run plan, the GitHub App registration link when no App id is passed, or the inferred App settings and published runner image after deploy. Never carries the OpenRouter key or the App private key.",
  "$defs": {
    "dryRun": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dry_run": {
          "const": true
        },
        "plan": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "dry_run",
        "plan"
      ]
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/dryRun"
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "phase": {
          "const": "register"
        },
        "context": {
          "type": "string"
        },
        "kind_cluster": {
          "type": [
            "string",
            "null"
          ]
        },
        "github_app_registration_url": {
          "type": "string"
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "phase",
        "context",
        "kind_cluster",
        "github_app_registration_url",
        "steps"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "phase": {
          "const": "ready"
        },
        "context": {
          "type": "string"
        },
        "repo": {
          "type": "string"
        },
        "intake": {
          "type": "string"
        },
        "github_app": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "app_id": {
              "type": "string"
            },
            "slug": {
              "type": "string"
            },
            "mention": {
              "type": "string"
            },
            "mention_inferred": {
              "type": "boolean"
            },
            "repos": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "label": {
              "type": "string"
            },
            "label_inferred": {
              "type": "boolean"
            }
          },
          "required": [
            "app_id",
            "slug",
            "mention",
            "mention_inferred",
            "repos",
            "label",
            "label_inferred"
          ]
        },
        "runner_image": {
          "type": "string"
        },
        "agent": {
          "type": "string"
        },
        "execution_deadline_seconds": {
          "type": "integer",
          "minimum": 0
        },
        "budget_usd": {
          "type": "number"
        },
        "reviewer_model": {
          "type": "string"
        },
        "run_credit_usd": {
          "type": "number"
        },
        "credit_remaining_usd": {
          "type": [
            "number",
            "null"
          ]
        }
      },
      "required": [
        "phase",
        "context",
        "repo",
        "intake",
        "github_app",
        "runner_image",
        "agent",
        "execution_deadline_seconds",
        "budget_usd"
      ]
    }
  ]
}
