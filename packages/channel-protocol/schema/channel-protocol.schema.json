{
  "$defs": {
    "Action": {
      "additionalProperties": false,
      "description": "A semantic response the user may select; adapters choose its widget.",
      "properties": {
        "label": {
          "maxLength": 75,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "value": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "label",
        "value"
      ],
      "title": "Action",
      "type": "object"
    },
    "ChannelCapabilities": {
      "additionalProperties": false,
      "properties": {
        "capabilities": {
          "items": {
            "$ref": "#/$defs/ChannelCapability"
          },
          "title": "Capabilities",
          "type": "array"
        },
        "version": {
          "const": "1.0",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "version"
      ],
      "title": "ChannelCapabilities",
      "type": "object"
    },
    "ChannelCapability": {
      "enum": [
        "interactive-actions",
        "live-steering",
        "streaming",
        "rich-cards",
        "threading",
        "file-attachments",
        "history-read",
        "canvas-read",
        "canvas-edit"
      ],
      "title": "ChannelCapability",
      "type": "string"
    },
    "ChoiceIntent": {
      "additionalProperties": false,
      "properties": {
        "allow_free_text": {
          "default": true,
          "title": "Allow Free Text",
          "type": "boolean"
        },
        "id": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "const": "choice",
          "title": "Kind",
          "type": "string"
        },
        "options": {
          "items": {
            "$ref": "#/$defs/Action"
          },
          "maxItems": 10,
          "minItems": 1,
          "title": "Options",
          "type": "array"
        },
        "prompt": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prompt"
        }
      },
      "required": [
        "kind",
        "id",
        "options"
      ],
      "title": "ChoiceIntent",
      "type": "object"
    },
    "ConfirmIntent": {
      "additionalProperties": false,
      "properties": {
        "allow_free_text": {
          "default": false,
          "title": "Allow Free Text",
          "type": "boolean"
        },
        "cancel": {
          "$ref": "#/$defs/Action"
        },
        "confirm": {
          "$ref": "#/$defs/Action"
        },
        "id": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "const": "confirm",
          "title": "Kind",
          "type": "string"
        },
        "prompt": {
          "title": "Prompt",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "id",
        "prompt",
        "confirm",
        "cancel"
      ],
      "title": "ConfirmIntent",
      "type": "object"
    },
    "MessageField": {
      "additionalProperties": false,
      "properties": {
        "label": {
          "title": "Label",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "label",
        "value"
      ],
      "title": "MessageField",
      "type": "object"
    },
    "MessageLink": {
      "additionalProperties": false,
      "properties": {
        "label": {
          "title": "Label",
          "type": "string"
        },
        "url": {
          "title": "Url",
          "type": "string"
        }
      },
      "required": [
        "label",
        "url"
      ],
      "title": "MessageLink",
      "type": "object"
    },
    "MilestoneClass": {
      "description": "Why a durable interruption is warranted (ADR-0130 section 3).\n\nA class is a reason, not a step: a chain may skip one or repeat one while\nits milestone budget lasts.",
      "enum": [
        "evidence",
        "scope",
        "verification"
      ],
      "title": "MilestoneClass",
      "type": "string"
    },
    "NavAffordance": {
      "additionalProperties": false,
      "description": "The no-dead-ends way back, in wire terms.\n\nThe worker-local ``NavPack`` cannot cross into this package without\ninverting the dependency, so the worker's sink layer maps an ENABLED pack to\nthis and a disabled one to ``None``: absence is the disabled form, and there\nis no dead affordance on the wire.",
      "properties": {
        "command": {
          "title": "Command",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        }
      },
      "required": [
        "label",
        "command"
      ],
      "title": "NavAffordance",
      "type": "object"
    },
    "OutboundMessage": {
      "additionalProperties": false,
      "description": "One adapter-neutral reply with a mandatory complete text fallback.",
      "properties": {
        "fields": {
          "items": {
            "$ref": "#/$defs/MessageField"
          },
          "title": "Fields",
          "type": "array"
        },
        "footer": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Footer"
        },
        "header": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Header"
        },
        "interaction": {
          "anyOf": [
            {
              "discriminator": {
                "mapping": {
                  "choice": "#/$defs/ChoiceIntent",
                  "confirm": "#/$defs/ConfirmIntent"
                },
                "propertyName": "kind"
              },
              "oneOf": [
                {
                  "$ref": "#/$defs/ChoiceIntent"
                },
                {
                  "$ref": "#/$defs/ConfirmIntent"
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Interaction"
        },
        "links": {
          "items": {
            "$ref": "#/$defs/MessageLink"
          },
          "title": "Links",
          "type": "array"
        },
        "status": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Status"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "version": {
          "const": "1.0",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "version",
        "text"
      ],
      "title": "OutboundMessage",
      "type": "object"
    },
    "ProgressCard": {
      "additionalProperties": false,
      "description": "The semantic form of a turn chain's one mutable progress card.",
      "properties": {
        "kind": {
          "const": "card",
          "title": "Kind",
          "type": "string"
        },
        "revision": {
          "description": "Counts the record's accepted updates from 1. A higher revision supersedes a lower one, so an adapter can drop a stale redelivery.",
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        },
        "state": {
          "$ref": "#/$defs/ProgressState"
        },
        "summary": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[^\n\r\u000b\f\u001c\u001d\u001e\u0085\u2028\u2029]+$",
          "title": "Summary",
          "type": "string"
        },
        "terminal": {
          "description": "True exactly when state is complete, failed or cancelled. Carried so an adapter renders the closed card without its own copy of that set.",
          "title": "Terminal",
          "type": "boolean"
        }
      },
      "required": [
        "kind",
        "state",
        "summary",
        "revision",
        "terminal"
      ],
      "title": "ProgressCard",
      "type": "object"
    },
    "ProgressCommand": {
      "additionalProperties": false,
      "description": "One deliberate progress update, as a model submits it.",
      "properties": {
        "milestone": {
          "anyOf": [
            {
              "$ref": "#/$defs/MilestoneClass"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Requests a durable milestone reply of this class. The milestone budget is the platform's to apply, not the command's to state."
        },
        "state": {
          "$ref": "#/$defs/ProgressState"
        },
        "summary": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[^\n\r\u000b\f\u001c\u001d\u001e\u0085\u2028\u2029]+$",
          "title": "Summary",
          "type": "string"
        },
        "update_id": {
          "description": "Identifies this update within its record, for idempotency.",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}$",
          "title": "Update Id",
          "type": "string"
        },
        "version": {
          "const": "1.0",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "version",
        "update_id",
        "state",
        "summary"
      ],
      "title": "ProgressCommand",
      "type": "object"
    },
    "ProgressMilestone": {
      "additionalProperties": false,
      "description": "One durable milestone reply of a turn chain.",
      "properties": {
        "kind": {
          "const": "milestone",
          "title": "Kind",
          "type": "string"
        },
        "milestone": {
          "$ref": "#/$defs/MilestoneClass"
        },
        "ordinal": {
          "description": "The chain's milestone slot this reply holds, from 1. The bound makes a fourth milestone inexpressible on the wire.",
          "maximum": 3,
          "minimum": 1,
          "title": "Ordinal",
          "type": "integer"
        },
        "summary": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[^\n\r\u000b\f\u001c\u001d\u001e\u0085\u2028\u2029]+$",
          "title": "Summary",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "milestone",
        "summary",
        "ordinal"
      ],
      "title": "ProgressMilestone",
      "type": "object"
    },
    "ProgressState": {
      "description": "The initial state set, in ADR-0130 section 1's order.",
      "enum": [
        "queued",
        "investigating",
        "awaiting-approval",
        "preparing-workspace",
        "testing",
        "publishing",
        "complete",
        "failed",
        "cancelled"
      ],
      "title": "ProgressState",
      "type": "string"
    },
    "ReplyAck": {
      "additionalProperties": false,
      "description": "What an adapter answers with. ``ref`` is None when it mints no handle.",
      "properties": {
        "ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ref"
        }
      },
      "title": "ReplyAck",
      "type": "object"
    },
    "ReplyPost": {
      "additionalProperties": false,
      "description": "A NEW platform-owned message, acked with its ref.\n\nThe approval card, or, 1.1 only, a progress card's first revision or a\nmilestone. ``message.text`` is the complete plain-text fallback either way.",
      "properties": {
        "delivery_id": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Reply wire 1.1. The platform-minted idempotency key of this one post or edit; a retry of an ambiguous attempt carries the same value. Outbound, and unrelated to the inbound delivery_id an adapter sends to POST /channels/turns.",
          "title": "Delivery Id"
        },
        "event": {
          "const": "reply.post",
          "title": "Event",
          "type": "string"
        },
        "message": {
          "$ref": "#/$defs/OutboundMessage"
        },
        "progress": {
          "anyOf": [
            {
              "discriminator": {
                "mapping": {
                  "card": "#/$defs/ProgressCard",
                  "milestone": "#/$defs/ProgressMilestone"
                },
                "propertyName": "kind"
              },
              "oneOf": [
                {
                  "$ref": "#/$defs/ProgressCard"
                },
                {
                  "$ref": "#/$defs/ProgressMilestone"
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Reply wire 1.1. A progress card's first revision or a milestone; message.text is its plain-text fallback and carries no interaction.",
          "title": "Progress"
        },
        "requested_by": {
          "title": "Requested By",
          "type": "string"
        },
        "target": {
          "$ref": "#/$defs/ReplyTarget"
        },
        "version": {
          "enum": [
            "1.0",
            "1.1"
          ],
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "version",
        "target",
        "event",
        "message",
        "requested_by"
      ],
      "title": "ReplyPost",
      "type": "object"
    },
    "ReplyTarget": {
      "additionalProperties": false,
      "description": "Where a reply belongs, in the channel's own terms.\n\n``conversation_id`` is None for a message that belongs to no conversation\n(a policy-routed approval card posted top-level in a channel that never\nasked). ``reply_ref`` is None when the channel has no addressable handle to\nedit yet.",
      "properties": {
        "address": {
          "title": "Address",
          "type": "string"
        },
        "conversation_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Conversation Id"
        },
        "kind": {
          "title": "Kind",
          "type": "string"
        },
        "reply_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reply Ref"
        }
      },
      "required": [
        "kind",
        "address",
        "conversation_id",
        "reply_ref"
      ],
      "title": "ReplyTarget",
      "type": "object"
    },
    "ReplyUpdate": {
      "additionalProperties": false,
      "description": "The turn's reply, edited in place where the channel supports it.\n\n``text`` is a streamed or final reply. ``message`` plus ``settled`` is the\nother form: an already-posted platform message being settled (an approval\ncard that expired or was resolved). ``progress`` is the third, 1.1 only: an\nedit of the progress card ``target.reply_ref`` names, carrying none of the\nanswer fields.",
      "properties": {
        "delivery_id": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Reply wire 1.1. The platform-minted idempotency key of this one post or edit; a retry of an ambiguous attempt carries the same value. Outbound, and unrelated to the inbound delivery_id an adapter sends to POST /channels/turns.",
          "title": "Delivery Id"
        },
        "event": {
          "const": "reply.update",
          "title": "Event",
          "type": "string"
        },
        "message": {
          "anyOf": [
            {
              "$ref": "#/$defs/OutboundMessage"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "nav": {
          "anyOf": [
            {
              "$ref": "#/$defs/NavAffordance"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "progress": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProgressCard"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Reply wire 1.1. An edit of the progress card target.reply_ref names; the body then carries no text, message, settled or nav."
        },
        "settled": {
          "anyOf": [
            {
              "$ref": "#/$defs/SettledOutcome"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "target": {
          "$ref": "#/$defs/ReplyTarget"
        },
        "text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Text"
        },
        "version": {
          "enum": [
            "1.0",
            "1.1"
          ],
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "version",
        "target",
        "event"
      ],
      "title": "ReplyUpdate",
      "type": "object"
    },
    "SettledOutcome": {
      "additionalProperties": false,
      "description": "How an approval ended, for the settled-card render.\n\n``decision`` is None when nobody decided, which is the expiry case; a\nnon-None value is the resolved case and brings ``resolver`` with it.",
      "properties": {
        "decision": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Decision"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        },
        "requested_by": {
          "title": "Requested By",
          "type": "string"
        },
        "resolver": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Resolver"
        }
      },
      "required": [
        "requested_by"
      ],
      "title": "SettledOutcome",
      "type": "object"
    },
    "TurnCompleted": {
      "additionalProperties": false,
      "description": "The turn reached a terminal outcome. The adapter's delivery trigger.\n\n``event_id`` is the dedupe key: at-least-once delivery means a duplicate is\nunavoidable, so it is made identifiable rather than pretended away.",
      "properties": {
        "event": {
          "const": "turn.completed",
          "title": "Event",
          "type": "string"
        },
        "event_id": {
          "title": "Event Id",
          "type": "string"
        },
        "outcome": {
          "enum": [
            "delivered",
            "dropped",
            "escalated",
            "awaiting-approval"
          ],
          "title": "Outcome",
          "type": "string"
        },
        "target": {
          "$ref": "#/$defs/ReplyTarget"
        },
        "version": {
          "const": "1.0",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "version",
        "target",
        "event",
        "event_id",
        "outcome"
      ],
      "title": "TurnCompleted",
      "type": "object"
    },
    "TurnStatus": {
      "additionalProperties": false,
      "description": "The channel's liveness caption. An EMPTY status is the clear.",
      "properties": {
        "event": {
          "const": "turn.status",
          "title": "Event",
          "type": "string"
        },
        "status": {
          "title": "Status",
          "type": "string"
        },
        "target": {
          "$ref": "#/$defs/ReplyTarget"
        },
        "version": {
          "const": "1.0",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "version",
        "target",
        "event",
        "status"
      ],
      "title": "TurnStatus",
      "type": "object"
    }
  },
  "$id": "https://curietech.ai/schemas/channel-protocol.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "messageVersion": "1.0",
  "title": "Curie Channel Protocol v1.0"
}
