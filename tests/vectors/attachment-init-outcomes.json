{
  "comment": "ADR 0205 decisions 4, 6 and 8: what a sandbox boot makes of one CURIE_ATTACHMENTS_REF payload. Two substrates redeem the same payload and must agree case by case: the rendered attachments-init program (executed by charts/curie/ci/attachment-init-behavior-assertions.sh against a fixture HTTP server) and the docker driver's _prepare_attachments (apps/worker/tests/sandbox/test_docker_attachment_claim.py, urlopen faked). Each entry is the wire entry (n/u/s/b/e/m) plus 'c': 1 for a file on the current message, 0 for an earlier one, and absent for a payload from a worker that predates the field, which is read as current. 'serve' says how the store answers: ok serves the body; expired mints the reference with a closed window (it must never be fetched); http_404/http_403/http_500 answer with that status; stall sends the headers and part of the body and then goes silent past the init container's fetch timeout; digest_mismatch serves bytes other than the ones the digest was minted from. outcome 'fatal' means the boot is refused and nothing is visible in the mount; 'ok' means 'visible' is exactly the set of non-hidden files in the mount (name -> bytes) and the status file holds exactly 'status' (order-insensitive by name). Every harness also checks, for every case: no current entry is fetched after an earlier one, an expired entry is never fetched, and an entry recorded unavailable for 'deadline' is never fetched.",
  "status_file": ".curie-attachments-status.json",
  "status_version": 1,
  "unavailable_reasons": ["expired", "not_found", "forbidden", "fetch_failed", "timeout", "deadline"],
  "cases": [
    {
      "name": "current_files_keep_their_exact_names",
      "entries": [
        {"n": "report.csv", "c": 1, "body": "a,b\n1,2\n", "serve": "ok"},
        {"n": "Q3 notes - final (v2).txt", "c": 1, "body": "hello attachment", "serve": "ok"}
      ],
      "outcome": "ok",
      "visible": {"report.csv": "a,b\n1,2\n", "Q3 notes - final (v2).txt": "hello attachment"},
      "status": [
        {"name": "report.csv", "status": "ok", "reason": null},
        {"name": "Q3 notes - final (v2).txt", "status": "ok", "reason": null}
      ]
    },
    {
      "name": "a_payload_without_c_is_all_current",
      "entries": [
        {"n": "a.txt", "body": "alpha", "serve": "ok"},
        {"n": "b.txt", "body": "bravo", "serve": "ok"}
      ],
      "outcome": "ok",
      "visible": {"a.txt": "alpha", "b.txt": "bravo"},
      "status": [
        {"name": "a.txt", "status": "ok", "reason": null},
        {"name": "b.txt", "status": "ok", "reason": null}
      ]
    },
    {
      "name": "an_expired_entry_without_c_is_current_and_fatal",
      "entries": [
        {"n": "a.txt", "body": "alpha", "serve": "ok"},
        {"n": "b.txt", "body": "bravo", "serve": "expired"}
      ],
      "outcome": "fatal"
    },
    {
      "name": "earlier_and_current_names_are_written_as_recorded",
      "entries": [
        {"n": "report.pdf", "c": 0, "body": "first report", "serve": "ok"},
        {"n": "report-2.pdf", "c": 1, "body": "second report", "serve": "ok"}
      ],
      "outcome": "ok",
      "visible": {"report.pdf": "first report", "report-2.pdf": "second report"},
      "status": [
        {"name": "report.pdf", "status": "ok", "reason": null},
        {"name": "report-2.pdf", "status": "ok", "reason": null}
      ]
    },
    {
      "name": "current_is_fetched_before_earlier_whatever_the_payload_order",
      "entries": [
        {"n": "old-1.txt", "c": 0, "body": "one", "serve": "ok"},
        {"n": "old-2.txt", "c": 0, "body": "two", "serve": "ok"},
        {"n": "new.txt", "c": 1, "body": "three", "serve": "ok"}
      ],
      "outcome": "ok",
      "visible": {"old-1.txt": "one", "old-2.txt": "two", "new.txt": "three"},
      "status": [
        {"name": "old-1.txt", "status": "ok", "reason": null},
        {"name": "old-2.txt", "status": "ok", "reason": null},
        {"name": "new.txt", "status": "ok", "reason": null}
      ]
    },
    {
      "name": "an_expired_earlier_reference_is_skipped_and_recorded",
      "entries": [
        {"n": "old.csv", "c": 0, "body": "x,y\n", "serve": "expired"},
        {"n": "new.csv", "c": 1, "body": "a,b\n", "serve": "ok"}
      ],
      "outcome": "ok",
      "visible": {"new.csv": "a,b\n"},
      "status": [
        {"name": "old.csv", "status": "unavailable", "reason": "expired"},
        {"name": "new.csv", "status": "ok", "reason": null}
      ]
    },
    {
      "name": "a_text_only_boot_whose_earlier_references_all_expired_still_boots",
      "entries": [
        {"n": "old-1.csv", "c": 0, "body": "1", "serve": "expired"},
        {"n": "old-2.csv", "c": 0, "body": "2", "serve": "expired"}
      ],
      "outcome": "ok",
      "visible": {},
      "status": [
        {"name": "old-1.csv", "status": "unavailable", "reason": "expired"},
        {"name": "old-2.csv", "status": "unavailable", "reason": "expired"}
      ]
    },
    {
      "name": "earlier_http_errors_are_skipped_with_their_reason",
      "entries": [
        {"n": "gone.pdf", "c": 0, "body": "gone", "serve": "http_404"},
        {"n": "revoked.pdf", "c": 0, "body": "revoked", "serve": "http_403"},
        {"n": "broken.pdf", "c": 0, "body": "broken", "serve": "http_500"},
        {"n": "fine.pdf", "c": 0, "body": "fine", "serve": "ok"},
        {"n": "now.txt", "c": 1, "body": "now", "serve": "ok"}
      ],
      "outcome": "ok",
      "visible": {"fine.pdf": "fine", "now.txt": "now"},
      "status": [
        {"name": "gone.pdf", "status": "unavailable", "reason": "not_found"},
        {"name": "revoked.pdf", "status": "unavailable", "reason": "forbidden"},
        {"name": "broken.pdf", "status": "unavailable", "reason": "fetch_failed"},
        {"name": "fine.pdf", "status": "ok", "reason": null},
        {"name": "now.txt", "status": "ok", "reason": null}
      ]
    },
    {
      "name": "an_earlier_fetch_that_stalls_is_skipped_as_timeout",
      "entries": [
        {"n": "now.txt", "c": 1, "body": "now", "serve": "ok"},
        {"n": "slow.bin", "c": 0, "body": "slow bytes", "serve": "stall"}
      ],
      "outcome": "ok",
      "visible": {"now.txt": "now"},
      "status": [
        {"name": "now.txt", "status": "ok", "reason": null},
        {"name": "slow.bin", "status": "unavailable", "reason": "timeout"}
      ]
    },
    {
      "name": "an_earlier_reference_reached_after_the_deadline_is_skipped_unfetched",
      "entries": [
        {"n": "slow.bin", "c": 0, "body": "slow bytes", "serve": "stall"},
        {"n": "late.txt", "c": 0, "body": "late", "serve": "ok"},
        {"n": "now.txt", "c": 1, "body": "now", "serve": "ok"}
      ],
      "outcome": "ok",
      "visible": {"now.txt": "now"},
      "status": [
        {"name": "slow.bin", "status": "unavailable", "reason": "timeout"},
        {"name": "late.txt", "status": "unavailable", "reason": "deadline"},
        {"name": "now.txt", "status": "ok", "reason": null}
      ]
    },
    {
      "name": "an_expired_current_reference_is_fatal",
      "entries": [
        {"n": "old.txt", "c": 0, "body": "old", "serve": "ok"},
        {"n": "now.txt", "c": 1, "body": "now", "serve": "expired"}
      ],
      "outcome": "fatal"
    },
    {
      "name": "a_current_http_error_is_fatal",
      "entries": [
        {"n": "now.txt", "c": 1, "body": "now", "serve": "http_404"}
      ],
      "outcome": "fatal"
    },
    {
      "name": "a_current_fetch_that_stalls_is_fatal",
      "entries": [
        {"n": "now.txt", "c": 1, "body": "now", "serve": "stall"}
      ],
      "outcome": "fatal"
    },
    {
      "name": "a_current_digest_mismatch_is_fatal",
      "entries": [
        {"n": "now.txt", "c": 1, "body": "now", "serve": "digest_mismatch"}
      ],
      "outcome": "fatal"
    },
    {
      "name": "an_earlier_digest_mismatch_is_fatal_not_skipped",
      "entries": [
        {"n": "old.txt", "c": 0, "body": "old", "serve": "digest_mismatch"},
        {"n": "now.txt", "c": 1, "body": "now", "serve": "ok"}
      ],
      "outcome": "fatal"
    },
    {
      "name": "a_name_with_a_parent_traversal_is_fatal",
      "entries": [{"n": "../escape.csv", "c": 1, "body": "x", "serve": "ok"}],
      "outcome": "fatal"
    },
    {
      "name": "a_name_with_a_directory_is_fatal",
      "entries": [{"n": "dir/report.csv", "c": 1, "body": "x", "serve": "ok"}],
      "outcome": "fatal"
    },
    {
      "name": "an_unclean_earlier_name_is_fatal_too",
      "entries": [
        {"n": "../old.csv", "c": 0, "body": "x", "serve": "ok"},
        {"n": "now.csv", "c": 1, "body": "y", "serve": "ok"}
      ],
      "outcome": "fatal"
    },
    {
      "name": "an_empty_name_is_fatal",
      "entries": [{"n": "", "c": 1, "body": "x", "serve": "ok"}],
      "outcome": "fatal"
    },
    {
      "name": "a_dot_name_is_fatal",
      "entries": [{"n": ".", "c": 1, "body": "x", "serve": "ok"}],
      "outcome": "fatal"
    },
    {
      "name": "a_dot_dot_name_is_fatal",
      "entries": [{"n": "..", "c": 1, "body": "x", "serve": "ok"}],
      "outcome": "fatal"
    },
    {
      "name": "a_slash_name_is_fatal",
      "entries": [{"n": "/", "c": 1, "body": "x", "serve": "ok"}],
      "outcome": "fatal"
    },
    {
      "name": "a_name_shadowing_the_status_file_is_fatal",
      "entries": [{"n": ".curie-attachments-status.json", "c": 1, "body": "{}", "serve": "ok"}],
      "outcome": "fatal"
    },
    {
      "name": "a_name_in_the_reserved_prefix_is_fatal",
      "entries": [{"n": ".curie-anything", "c": 0, "body": "x", "serve": "ok"}],
      "outcome": "fatal"
    },
    {
      "name": "a_duplicate_name_across_earlier_and_current_is_fatal",
      "entries": [
        {"n": "report.pdf", "c": 0, "body": "one", "serve": "ok"},
        {"n": "report.pdf", "c": 1, "body": "two", "serve": "ok"}
      ],
      "outcome": "fatal"
    },
    {
      "name": "a_duplicate_name_within_current_is_fatal",
      "entries": [
        {"n": "report.pdf", "c": 1, "body": "one", "serve": "ok"},
        {"n": "report.pdf", "c": 1, "body": "two", "serve": "ok"}
      ],
      "outcome": "fatal"
    }
  ]
}
