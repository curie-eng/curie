    {"name": "trailing-decimal", "value": "1.", "valid": true},
    {"name": "positive-sign", "value": "+1", "valid": true},
    {"name": "binary-kilo", "value": "1Ki", "valid": true},
    {"name": "binary-giga", "value": "1Gi", "valid": true},
    {"name": "binary-fraction", "value": "1.5Gi", "valid": true},
    {"name": "decimal-kilo", "value": "1k", "valid": true},
    {"name": "decimal-mega", "value": "1M", "valid": true},
    {"name": "exponent", "value": "1e3", "valid": true},
    {"name": "negative-exponent", "value": "1e-3", "valid": true},
    {"name": "positive-exponent", "value": "1E+3", "valid": true},
    {"name": "empty", "value": "", "valid": false},
    {"name": "whitespace", "value": " ", "valid": false},
    {"name": "zero", "value": "0", "valid": false},
    {"name": "zero-binary", "value": "0Gi", "valid": false},
    {"name": "zero-decimal", "value": "00.000m", "valid": false},
    {"name": "zero-exponent", "value": "0e3", "valid": false},
