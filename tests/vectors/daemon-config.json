{
  "daemon": {
    "namespace": "default-t-curie-docker",
    "image": "registry.example.com/acme/curie-docker-daemon@sha256:7777777777777777777777777777777777777777777777777777777777777777",
    "port": 2376,
    "selectorLabels": {
      "app.kubernetes.io/name": "curie",
      "app.kubernetes.io/instance": "t",
      "app.kubernetes.io/component": "docker-daemon"
    },
    "resources": {
      "requests": {"cpu": "500m", "memory": "1Gi", "ephemeral-storage": "10Gi"},
      "limits": {"cpu": "2", "memory": "4Gi", "ephemeral-storage": "20Gi"}
    },
    "storageSizeLimit": "20Gi",
    "maxClaimLifetimeSeconds": 86400,
    "pingTimeoutSeconds": 2
  },
  "quantities": [
