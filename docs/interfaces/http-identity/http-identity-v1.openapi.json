  "info": {
    "description": "Provider-hosted reference operation; deployment maps its lookup URL to this operation. This document registers no Curie API route. Facts grant no permission. Transport obligations are published but not implemented by the pure facts contract. Cross-object issuer equality, exact request echo and independent freshness require semantic validation.",
    "title": "HTTP identity facts provider",
    "version": "1"
  },
  "openapi": "3.1.0",
  "paths": {
    "/lookup": {
      "post": {
        "operationId": "lookupIdentityFactsV1",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LookupRequestV1"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LookupResponseV1"
                }
              }
            },
            "description": "Identity facts envelope; unavailable carries no usable facts"
          }
        },
        "summary": "Resolve captured sender scope to identity facts"
      }
    }
  },
  "x-curie-transport": {
    "follow_redirects": false,
