      "required": [
        "issuer",
        "subject",
        "kind",
        "account_status"
      ],
      "title": "CanonicalIdentityV1",
      "type": "object"
    },
    "GroupV1": {
      "additionalProperties": false,
      "description": "@spec HTTP-IDENTITY-V1-2.",
      "properties": {
        "id": {
          "minLength": 1,
