        "account_status": {
          "enum": [
            "active",
            "disabled",
            "revoked"
          ],
          "title": "Account Status",
          "type": "string"
        },
        "issuer": {
          "title": "Issuer",
          "type": "string"
        },
        "kind": {
          "enum": [
            "human",
            "service",
            "agent"
          ],
          "title": "Kind",
          "type": "string"
        },
        "subject": {
          "minLength": 1,
          "title": "Subject",
          "type": "string"
        }
