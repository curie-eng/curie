[5.006, "o", "\r\n\u001b[1m[3/5] Decision 3: a warm pool keyed by version\u001b[0m\r\n      \u001b[2mthe bundle is baked into the pool's template, not injected per claim\u001b[0m\r\n"]
[6.422, "o", "      \u001b[32m3 pods pre-fetched, pre-extracted, pre-booted in 6s -- paid once per version\u001b[0m\r\n"]
